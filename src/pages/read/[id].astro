---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
import { getArticle, formatBytes } from '../../lib/articles';
import { tokenizeParagraph } from '../../lib/reader-html';
import { paginate } from '../../lib/paginate';
import { getCachedTranslations } from '../../lib/translate';

const { id } = Astro.params;
const userId = Astro.locals.user!.id;
const article = id ? await getArticle(userId, id) : null;

if (!article) {
  return Astro.redirect('/');
}

// 分页：把文章按内容切成多页，URL 用 ?page=N 表示
const pages = paginate(article.blocks, { charsPerPage: siteConfig.pagination.charsPerPage });
const totalPages = pages.length;
const requested = Number(Astro.url.searchParams.get('page') || '1');
const currentPage = Math.min(Math.max(1, Number.isFinite(requested) ? Math.floor(requested) : 1), totalPages);
const page = pages[currentPage - 1];
const pageHref = (n: number) => `/read/${article.id}${n > 1 ? `?page=${n}` : ''}`;

// 已缓存的译文在服务端直接渲染，刷新 / 翻页后译文不会消失
const cachedTranslation = await getCachedTranslations(userId, article.id);
const cachedMap = new Map<number, string>();
if (cachedTranslation && cachedTranslation.targetLang === siteConfig.translation.targetLang) {
  for (const unit of page.units) {
    const hit = cachedTranslation.units[String(unit.index)];
    if (hit?.target) cachedMap.set(unit.index, hit.target);
  }
}
const hasCachedOnPage = cachedMap.size > 0; // 首屏是否已有译文

// 页码链接：页数多时用省略号折叠
const pageLinks: (number | '…')[] = [];
if (totalPages <= 9) {
  for (let i = 1; i <= totalPages; i++) pageLinks.push(i);
} else {
  pageLinks.push(1);
  const start = Math.max(2, currentPage - 1);
  const end = Math.min(totalPages - 1, currentPage + 1);
  if (start > 2) pageLinks.push('…');
  for (let i = start; i <= end; i++) pageLinks.push(i);
  if (end < totalPages - 1) pageLinks.push('…');
  pageLinks.push(totalPages);
}

// 所有页的原文（服务端直出），供前端做预翻译：{ page: N, units: [...] }
const allPageUnits = pages.map((p, i) => ({
  page: i + 1,
  units: p.units.map((u) => ({ index: u.index, text: u.text })),
}));

const readerMeta = {
  articleId: article.id,
  articleTitle: article.title,
  speechLang: siteConfig.speechLang,
  autoAdd: siteConfig.vocab.autoAddOnLookup,
  highlightLimit: siteConfig.limits.highlightLimit,
  currentPage,
  totalPages,
  hasCachedTranslation: hasCachedOnPage,
  /** 本页原文（服务端直出，避免前端从 DOM 取文本时把 HTML 实体当成正文） */
  pageUnits: page.units.map((u) => ({ index: u.index, text: u.text })),
  /** 全部页原文（预翻译用） */
  allPageUnits,
  /** 预翻译配置 */
  prefetchPages: siteConfig.translation.prefetchPages,
  prefetchTriggerPage: siteConfig.translation.prefetchTriggerPage,
  translation: {
    enabled: siteConfig.translation.provider !== 'none',
    provider: siteConfig.translation.provider,
    targetLang: siteConfig.translation.targetLang,
    label: siteConfig.translation.label,
    disclaimer: siteConfig.translation.disclaimer,
    compareFontScale: siteConfig.translation.compareFontScale,
  },
};

const pageWordCount = page.units.reduce(
  (sum, u) => sum + (u.text.match(/[A-Za-z]+(?:['’-][A-Za-z]+)*/g)?.length ?? 0),
  0
);
---

<BaseLayout current="/" title={`${article.title}${totalPages > 1 ? ` · 第 ${currentPage}/${totalPages} 页` : ''}`}>
  {/*
    遮挡译文：首帧前恢复上次选择。已缓存的译文是服务端直出的，
    不在这里先打标记，刷新时会先看到译文再被遮住（闪一下）。
  */}
  <script is:inline>
    try {
      if (localStorage.getItem('readbook.reader.translateMask.v1') === '1') {
        document.documentElement.dataset.zhMask = '1';
      }
    } catch (e) {}
  </script>
  <div class="reader-toolbar">
    <a class="btn btn-sm" href="/">← 返回列表</a>
    <a class="btn btn-sm" href="/vocabulary">生词本</a>
    <span class="spacer"></span>
    <button class="btn btn-sm" id="translate-btn" type="button" aria-pressed="false" hidden>{siteConfig.translation.label}</button>
    <button class="btn btn-sm btn-danger" id="rename-btn" type="button">改标题</button>
    <button class="btn btn-sm btn-danger" id="delete-btn" type="button">删除文章</button>
  </div>
  <div class="row small" id="translate-bar" hidden style="margin:-6px 0 14px; gap:8px">
    <span class="muted" style="flex:none">{siteConfig.translation.label}：</span>
    <div class="seg" role="group" aria-label="译文显示方式">
      <button type="button" class="seg-btn" data-mode="columns" aria-pressed="true" title="左右两栏：原文在左、译文在右">两栏对照</button>
      <button type="button" class="seg-btn" data-mode="both" aria-pressed="false" title="英文原文，下面紧跟中文">上下对照</button>
      <button type="button" class="seg-btn" data-mode="zh" aria-pressed="false">只看译文</button>
      <button type="button" class="seg-btn" data-mode="en" aria-pressed="false">只看原文</button>
    </div>
    <button class="btn btn-sm btn-ghost" id="translate-mask" type="button" aria-pressed="false" hidden title="把译文模糊掉，点某一段才显示该段">遮挡译文</button>
    <button class="btn btn-sm btn-ghost" id="translate-retry" type="button" hidden title="重新请求本页翻译并覆盖缓存">重新翻译</button>
    <span id="translate-status" class="muted" style="flex:1 1 100%; min-width:0"></span>
  </div>
  <p class="hint" style="margin:-6px 0 14px">点击任意英文单词查看释义并发音；译文会保存在账号里，翻页和刷新都不会丢</p>

  <div class="row" style="justify-content:space-between; align-items:flex-end">
    <h1 class="page-title" id="article-title" style="margin-bottom:0">{article.title}</h1>
  </div>
  <p class="page-sub" style="margin-top:6px">
    全文 {article.wordCount} 词 · {formatBytes(article.bytes)}
    {totalPages > 1 && <span> · 第 {currentPage} / {totalPages} 页（本页 {pageWordCount} 词）</span>}
    <span> · <span id="vocab-stat">…</span></span>
  </p>

  {
    totalPages > 1 && (
      <nav class="pager pager-top" aria-label="分页">
        {currentPage > 1 ? (
          <a class="btn btn-sm" href={pageHref(currentPage - 1)} rel="prev">‹ 上一页</a>
        ) : (
          <button class="btn btn-sm" type="button" disabled>‹ 上一页</button>
        )}
        <div class="pager-numbers">
          {pageLinks.map((n) =>
            n === '…' ? (
              <span class="pager-ellipsis">…</span>
            ) : (
              <a
                class={`pager-num ${n === currentPage ? 'active' : ''}`}
                href={pageHref(n)}
                aria-current={n === currentPage ? 'page' : undefined}
              >
                {n}
              </a>
            )
          )}
        </div>
        {currentPage < totalPages ? (
          <a class="btn btn-sm" href={pageHref(currentPage + 1)} rel="next">下一页 ›</a>
        ) : (
          <button class="btn btn-sm" type="button" disabled>下一页 ›</button>
        )}
        {/* 跳页：原生 GET 表单，回车或点「跳转」都直接跳 ?page=N，不依赖 JS */}
        <form class="pager-jump" method="get" action={`/read/${article.id}`}>
          <label class="small muted" for="page-jump">跳至</label>
          <input
            class="pager-jump-input"
            id="page-jump"
            name="page"
            type="number"
            inputmode="numeric"
            min="1"
            max={totalPages}
            value={currentPage}
            aria-label={`跳转页码，范围 1 到 ${totalPages}`}
          />
          <span class="small muted">/ {totalPages} 页</span>
          <button class="btn btn-sm" type="submit">跳转</button>
        </form>
      </nav>
    )
  }

  <div class="card" style="padding:16px 18px">
    <div class="row small" style="justify-content:space-between; align-items:center">
      <strong style="font-size:14px">本文生词</strong>
      <a href="/vocabulary" class="small">去生词本 →</a>
    </div>
    <div id="article-vocab" style="margin-top:8px"></div>
  </div>

  <article class="reader" id="reader">
    {
      page.units.map((unit) => {
        const zh = cachedMap.get(unit.index) || '';
        const zhClass = `zh-block${zh ? '' : ' is-empty'}${unit.type === 'heading' ? ' zh-heading' : ''}`;
        return (
          <div class="reader-block" data-block={unit.index} data-type={unit.type}>
            {unit.type === 'heading' ? <h2>{unit.text}</h2> : <p set:html={tokenizeParagraph(unit.text)} />}
            <div class={zhClass} data-has-cache={zh ? '1' : '0'}>
              {zh || ''}
            </div>
          </div>
        );
      })
    }
  </article>

  {
    totalPages > 1 && (
      <nav class="pager pager-bottom" aria-label="分页">
        {currentPage > 1 ? (
          <a class="btn" href={pageHref(currentPage - 1)} rel="prev">‹ 上一页</a>
        ) : (
          <button class="btn" type="button" disabled>‹ 上一页</button>
        )}
        <span class="muted small">第 {currentPage} / {totalPages} 页</span>
        {currentPage < totalPages ? (
          <a class="btn btn-primary" href={pageHref(currentPage + 1)} rel="next">下一页 ›</a>
        ) : (
          <a class="btn btn-primary" href="/">全书完 · 返回列表</a>
        )}
      </nav>
    )
  }

  <div class="row" style="margin-top:16px; justify-content:center">
    <a class="btn" href="/">← 返回列表</a>
  </div>

  <div class="popover" id="word-popover" role="dialog" aria-label="单词释义" hidden></div>

  <script id="reader-meta" type="application/json" set:html={JSON.stringify(readerMeta)} />
  <script>
    import '../../scripts/client/reader';
    import { initTranslate } from '../../scripts/client/translate';
    import { askText, confirmDelete, notify } from '../../scripts/client/dialog';
    import { initKeyboardPaging } from '../../scripts/client/reader/pager';

    initTranslate();

    const title = document.getElementById('article-title');

    // 改标题 / 删除文章
    const articleId = document.querySelector<HTMLScriptElement>('#reader-meta')?.textContent
      ? (JSON.parse(document.querySelector<HTMLScriptElement>('#reader-meta')!.textContent || '{}') as { articleId: string }).articleId
      : '';

    document.getElementById('rename-btn')?.addEventListener('click', async () => {
      const current = title?.textContent || '';
      const next = await askText('修改文章标题', current, '', '输入新的标题', {
        requiredMessage: '标题不能为空',
      });
      if (!next || next === current) return;
      const res = await fetch(`/api/articles?id=${encodeURIComponent(articleId)}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ title: next }),
      });
      if (res.ok && title) {
        title.textContent = next;
        document.title = `${next} · ${document.title.split(' · ').pop()}`;
      } else {
        await notify('修改失败', '请稍后再试。');
      }
    });

    document.getElementById('delete-btn')?.addEventListener('click', async () => {
      const ok = await confirmDelete(
        '删除这篇文章？',
        '文章正文会从服务器删除，生词本里的单词不会被删除。此操作不可恢复。',
        '删除文章'
      );
      if (!ok) return;
      const res = await fetch(`/api/articles?id=${encodeURIComponent(articleId)}`, { method: 'DELETE' });
      if (res.ok) location.href = '/';
      else await notify('删除失败', '请稍后再试。');
    });

    // 键盘翻页：← / →（输入框、弹窗内不触发）
    const meta = JSON.parse(document.getElementById('reader-meta')?.textContent || '{}') as {
      articleId: string;
      currentPage: number;
      totalPages: number;
    };
    initKeyboardPaging(meta);
  </script>
</BaseLayout>
