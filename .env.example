# ReadBook env (copy to .env, ASCII only: Node reads .env as UTF-8, Chinese comments may break it)
# Accounts are stored in data/users.json; there is no shared passcode anymore.
#
# NOTE: when .env does not exist, `npm run dev/build/start` copies this file to .env
# and fills SESSION_SECRET with a random value (see scripts/prepare.mjs).
# Never commit a real .env.

# Session signing secret. Leave EMPTY only for a local throwaway run: an empty value
# falls back to a well-known dev string, which makes session cookies forgeable.
# Production: any long random string. Changing it logs everyone out.
SESSION_SECRET=

# Administrator account. Used only for the admin console at /admin.
# The first login with these credentials creates the admin record automatically.
# Leave ADMIN_PASSWORD empty to disable the configured admin: the first person who
# registers becomes the site owner instead (avoids shipping a default admin/admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Days a browser stays logged in
SESSION_DAYS=30

# Data dir: users.json + users/<id>/{articles,vocabulary.json,translations} + dict.db
DATA_DIR=data

# Listen address / port
HOST=127.0.0.1
PORT=4321

# Set to 1 when behind an HTTPS reverse proxy
COOKIE_SECURE=0

# Online dictionary fallback template, {word} placeholder.
# Empty = use the built-in default (youdao dictionary). Set to "off" to disable.
# Expected JSON: {"translation":"...","phonetic":"..."} or {"data":{...}}
ONLINE_DICT_URL=

# Custom full-text translation endpoint, {q} = text, {to} = target lang.
# Leave empty to use the built-in provider set in src/config/site.ts (default: tencent).
# Expected JSON: {"translation":"..."} or {"translatedText":"..."} or {"data":{"translatedText":"..."}}
ONLINE_TRANSLATE_URL=
