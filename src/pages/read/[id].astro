---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
import { getArticle, formatBytes } from '../../lib/articles';
import { tokenizeParagraph } from '../../lib/reader-html';
import { paginate } from '../../lib/paginate';
import { buildChapters, chapterUnitIndexes, currentChapter } from '../../lib/chapters';
import { getArticleProgress, saveArticleProgress } from '../../lib/progress';
import { listArticleNotes } from '../../lib/notes';
import { countChineseChars, type ArticleLang } from '../../lib/text';
import { getCachedTranslations, getProvider } from '../../lib/translate';
import { getUserTranslationSettings } from '../../lib/translate-settings';

const { id } = Astro.params;
const userId = Astro.locals.user!.id;
const article = id ? await getArticle(userId, id) : null;

if (!article) {
  return Astro.redirect('/');
}

// 文章语言：中文文章走「纯阅读」分支（不点词、不翻译、不生词本）
const lang: ArticleLang = article.lang === 'zh' ? 'zh' : 'en';
const isZh = lang === 'zh';

// 分页：把文章按内容切成多页，URL 用 ?page=N 表示
// 中文一屏字更多，用 zhReader.charsPerPage（默认 1200 字/页）
const pages = paginate(article.blocks, {
  charsPerPage: isZh ? siteConfig.zhReader.charsPerPage : siteConfig.pagination.charsPerPage,
});
const totalPages = pages.length;
const requested = Number(Astro.url.searchParams.get('page') || '1');
const currentPage = Math.min(Math.max(1, Number.isFinite(requested) ? Math.floor(requested) : 1), totalPages);
const page = pages[currentPage - 1];
// 页码链接一律带 ?page=：第 1 页也带上，否则点「1」回到无参数地址会被自动续读弹回上次页
const pageHref = (n: number) => `/read/${article.id}?page=${n}`;

// 章节：从已分页的块里识别（markdown 标题 + Chapter 1 / 第1章 这类显式标记）。
// 只做渲染层的叠加，不改分页、不写回文章，因此页码与翻译缓存键都不变。
const chapters = buildChapters(pages, {
  enabled: siteConfig.reader.chapters,
  maxTitleLen: siteConfig.reader.chapterTitleMaxLen,
});
const chapterStarts = chapterUnitIndexes(chapters);
const activeChapter = currentChapter(chapters, page.units[0]?.index ?? 0);

// 阅读进度：先读旧进度（用于自动续读），本次阅读再写回
const savedProgress = siteConfig.reader.rememberProgress ? await getArticleProgress(userId, article.id) : null;
const explicitPage = Astro.url.searchParams.has('page');
if (!explicitPage && siteConfig.reader.autoResume && savedProgress && savedProgress.page > 1) {
  const resume = Math.min(savedProgress.page, totalPages);
  if (resume > 1) return Astro.redirect(pageHref(resume));
}
if (siteConfig.reader.rememberProgress) {
  await saveArticleProgress(userId, article.id, currentPage, totalPages);
}

// 笔记：锚点是「全局块序号」，页码在这里反查，所以翻页、改分页大小都不会让笔记错位。
// 每条笔记还带一段原文（quote），对不上说明正文变过，就只提示「原文已变动」、不跳转。
const notesEnabled = siteConfig.reader.notes;
const articleNotes = notesEnabled ? await listArticleNotes(userId, article.id) : [];
const blockPage = new Map<number, number>();
const blockText = new Map<number, string>();
for (const p of pages) {
  for (const unit of p.units) {
    blockPage.set(unit.index, p.page);
    blockText.set(unit.index, unit.text);
  }
}
const noteItems = articleNotes.map((note) => {
  const pageNo = blockPage.get(note.blockIndex) ?? 0;
  const text = blockText.get(note.blockIndex) ?? '';
  const anchored = pageNo > 0 && (!note.quote || text.includes(note.quote));
  return { ...note, page: pageNo, anchored };
});
/** 块序号 → 该段的笔记条数（正文里给记过的段落加标记） */
const notesByBlock = new Map<number, number>();
for (const note of noteItems) {
  if (!note.anchored) continue;
  notesByBlock.set(note.blockIndex, (notesByBlock.get(note.blockIndex) ?? 0) + 1);
}

// 当前账号实际生效的翻译服务商（账号自选优先，否则站点默认）；中文文章不启用翻译
const translationSettings = isZh ? null : await getUserTranslationSettings(userId);
const activeProvider = isZh ? null : getProvider(translationSettings);

// 已缓存的译文在服务端直接渲染，刷新 / 翻页后译文不会消失
// 只渲染「当前服务商」翻译的缓存：换了服务商后旧译文不再顶替新结果
const cachedTranslation = isZh ? null : await getCachedTranslations(userId, article.id);
const cachedMap = new Map<number, string>();
if (
  cachedTranslation &&
  cachedTranslation.targetLang === siteConfig.translation.targetLang &&
  cachedTranslation.provider === (activeProvider?.id ?? '')
) {
  for (const unit of page.units) {
    const hit = cachedTranslation.units[String(unit.index)];
    if (hit?.target) cachedMap.set(unit.index, hit.target);
  }
}
const hasCachedOnPage = cachedMap.size > 0; // 首屏是否已有译文

// 页码链接：页数多时用省略号折叠
const pageLinks: (number | '…')[] = [];
if (totalPages <= 9) {
  for (let i = 1; i <= totalPages; i++) pageLinks.push(i);
} else {
  pageLinks.push(1);
  const start = Math.max(2, currentPage - 1);
  const end = Math.min(totalPages - 1, currentPage + 1);
  if (start > 2) pageLinks.push('…');
  for (let i = start; i <= end; i++) pageLinks.push(i);
  if (end < totalPages - 1) pageLinks.push('…');
  pageLinks.push(totalPages);
}

// 所有页的原文（服务端直出），供前端做预翻译：{ page: N, units: [...] }
const allPageUnits = pages.map((p, i) => ({
  page: i + 1,
  units: p.units.map((u) => ({ index: u.index, text: u.text })),
}));

const readerMeta = {
  articleId: article.id,
  articleTitle: article.title,
  lang,
  speechLang: siteConfig.speechLang,
  autoAdd: siteConfig.vocab.autoAddOnLookup,
  highlightLimit: siteConfig.limits.highlightLimit,
  currentPage,
  totalPages,
  hasCachedTranslation: hasCachedOnPage,
  /** 笔记（前端只负责增删改，面板与段落标记由服务端直出） */
  notes: {
    enabled: notesEnabled,
    maxNoteChars: siteConfig.limits.maxNoteChars,
  },
  /** 本页原文（服务端直出，避免前端从 DOM 取文本时把 HTML 实体当成正文） */
  pageUnits: page.units.map((u) => ({ index: u.index, text: u.text })),
  /** 全部页原文（预翻译用） */
  allPageUnits,
  /** 预翻译配置 */
  prefetchPages: siteConfig.translation.prefetchPages,
  prefetchTriggerPage: siteConfig.translation.prefetchTriggerPage,
  translation: {
    enabled: !isZh && !!activeProvider,
    provider: activeProvider?.id ?? siteConfig.translation.provider,
    providerLabel: activeProvider?.label ?? '',
    targetLang: siteConfig.translation.targetLang,
    label: siteConfig.translation.label,
    disclaimer: siteConfig.translation.disclaimer,
    compareFontScale: siteConfig.translation.compareFontScale,
  },
};

// 本页字数：英文按词、中文按字
const pageWordCount = isZh
  ? page.units.reduce((sum, u) => sum + countChineseChars(u.text), 0)
  : page.units.reduce((sum, u) => sum + (u.text.match(/[A-Za-z]+(?:['’-][A-Za-z]+)*/g)?.length ?? 0), 0);
---

<BaseLayout current="/" title={`${article.title}${totalPages > 1 ? ` · 第 ${currentPage}/${totalPages} 页` : ''}`}>
  {/*
    遮挡译文：首帧前恢复上次选择。已缓存的译文是服务端直出的，
    不在这里先打标记，刷新时会先看到译文再被遮住（闪一下）。
  */}
  <script is:inline>
    try {
      if (localStorage.getItem('readbook.reader.translateMask.v1') === '1') {
        document.documentElement.dataset.zhMask = '1';
      }
    } catch (e) {}
  </script>
  <div class="reader-toolbar">
    <a class="btn btn-sm" href={isZh ? '/zh' : '/'}>← 返回列表</a>
    {!isZh && <a class="btn btn-sm" href="/vocabulary">生词本</a>}
    {currentPage > 1 && <a class="btn btn-sm" href={pageHref(1)} title="回到第 1 页，并覆盖已记录的进度">从头开始</a>}
    <span class="spacer"></span>
    <button class="btn btn-sm" id="translate-btn" type="button" aria-pressed="false" hidden>{siteConfig.translation.label}</button>
    <button class="btn btn-sm btn-danger" id="rename-btn" type="button">改标题</button>
    <button class="btn btn-sm btn-danger" id="delete-btn" type="button">删除文章</button>
  </div>
  <div class="row small" id="translate-bar" hidden style="margin:-6px 0 14px; gap:8px">
    <span class="muted" style="flex:none">{siteConfig.translation.label}：</span>
    <div class="seg" role="group" aria-label="译文显示方式">
      <button type="button" class="seg-btn" data-mode="columns" aria-pressed="true" title="左右两栏：原文在左、译文在右">两栏对照</button>
      <button type="button" class="seg-btn" data-mode="both" aria-pressed="false" title="英文原文，下面紧跟中文">上下对照</button>
      <button type="button" class="seg-btn" data-mode="zh" aria-pressed="false">只看译文</button>
      <button type="button" class="seg-btn" data-mode="en" aria-pressed="false">只看原文</button>
    </div>
    <button class="btn btn-sm btn-ghost" id="translate-mask" type="button" aria-pressed="false" hidden title="把译文模糊掉，点某一段才显示该段">遮挡译文</button>
    <button class="btn btn-sm btn-ghost" id="translate-retry" type="button" hidden title="重新请求本页翻译并覆盖缓存">重新翻译</button>
    <span id="translate-status" class="muted" style="flex:1 1 100%; min-width:0"></span>
  </div>
  <p class="hint" style="margin:-6px 0 14px">
    {
      isZh
        ? '中文纯阅读：点击文字不会查词，也没有全文翻译；翻页与刷新都会停在当前页。'
        : '点击任意英文单词查看释义并发音；译文会保存在账号里，翻页和刷新都不会丢'
    }
  </p>

  <div class="row" style="justify-content:space-between; align-items:flex-end">
    <h1 class="page-title" id="article-title" style="margin-bottom:0">{article.title}</h1>
  </div>
  <p class="page-sub" style="margin-top:6px">
    全文 {article.wordCount} {isZh ? '字' : '词'} · {formatBytes(article.bytes)}
    {totalPages > 1 && <span> · 第 {currentPage} / {totalPages} 页（本页 {pageWordCount} {isZh ? '字' : '词'}）</span>}
    {!isZh && <span> · <span id="vocab-stat">…</span></span>}
  </p>

  {
    chapters.length >= 2 && (
      <details class="chapter-nav">
        <summary>
          <span class="chapter-nav-label">目录 · 共 {chapters.length} 章</span>
          {activeChapter && <span class="chapter-now">当前：{activeChapter.title}</span>}
        </summary>
        <ol class="chapter-list">
          {chapters.map((c, i) => (
            <li class={c.unitIndex === activeChapter?.unitIndex ? 'active' : ''}>
              <a href={pageHref(c.page)}>
                <span class="chapter-no">{i + 1}</span>
                <span class="chapter-name">{c.title}</span>
                <span class="chapter-page">第 {c.page} 页</span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    )
  }

  {
    totalPages > 1 && (
      <nav class="pager pager-top" aria-label="分页">
        {currentPage > 1 ? (
          <a class="btn btn-sm" href={pageHref(currentPage - 1)} rel="prev">‹ 上一页</a>
        ) : (
          <button class="btn btn-sm" type="button" disabled>‹ 上一页</button>
        )}
        <div class="pager-numbers">
          {pageLinks.map((n) =>
            n === '…' ? (
              <span class="pager-ellipsis">…</span>
            ) : (
              <a
                class={`pager-num ${n === currentPage ? 'active' : ''}`}
                href={pageHref(n)}
                aria-current={n === currentPage ? 'page' : undefined}
              >
                {n}
              </a>
            )
          )}
        </div>
        {currentPage < totalPages ? (
          <a class="btn btn-sm" href={pageHref(currentPage + 1)} rel="next">下一页 ›</a>
        ) : (
          <button class="btn btn-sm" type="button" disabled>下一页 ›</button>
        )}
        {/* 跳页：原生 GET 表单，回车或点「跳转」都直接跳 ?page=N，不依赖 JS */}
        <form class="pager-jump" method="get" action={`/read/${article.id}`}>
          <label class="small muted" for="page-jump">跳至</label>
          <input
            class="pager-jump-input"
            id="page-jump"
            name="page"
            type="number"
            inputmode="numeric"
            min="1"
            max={totalPages}
            value={currentPage}
            aria-label={`跳转页码，范围 1 到 ${totalPages}`}
          />
          <span class="small muted">/ {totalPages} 页</span>
          <button class="btn btn-sm" type="submit">跳转</button>
        </form>
      </nav>
    )
  }

  {
    !isZh && (
      <div class="card" style="padding:16px 18px">
        <div class="row small" style="justify-content:space-between; align-items:center">
          <strong style="font-size:14px">本文生词</strong>
          <a href="/vocabulary" class="small">去生词本 →</a>
        </div>
        <div id="article-vocab" style="margin-top:8px"></div>
      </div>
    )
  }

  {
    notesEnabled && (
      <details class="note-panel" id="note-panel" open={noteItems.length > 0}>
        <summary>
          <span class="note-panel-label">本文笔记 · 共 {noteItems.length} 条</span>
          <span class="note-panel-hint">点段落右侧的 ✎ 记一条</span>
        </summary>
        {noteItems.length === 0 ? (
          <p class="hint" style="margin:10px 0 0">
            还没有笔记。把鼠标移到正文段落上，点右侧的 ✎ 就能为这一段记一条；笔记按账号保存，换设备登录也在。
          </p>
        ) : (
          <ul class="note-list">
            {noteItems.map((note) => (
              <li class={`note-item${note.anchored ? '' : ' is-orphan'}`}>
                <div class="note-meta">
                  {note.anchored ? (
                    <a class="note-jump" href={`${pageHref(note.page)}#block-${note.blockIndex}`}>
                      第 {note.page} 页
                    </a>
                  ) : (
                    <span class="note-jump is-orphan" title="正文变过，这条笔记无法定位到原来的段落">
                      原文已变动
                    </span>
                  )}
                  {note.quote && <span class="note-quote">{note.quote}</span>}
                </div>
                <div class="note-body">{note.body}</div>
                <div class="note-actions">
                  <button
                    class="btn btn-sm btn-ghost"
                    type="button"
                    data-note-edit={note.id}
                    data-note-block={note.blockIndex}
                  >
                    编辑
                  </button>
                  <button class="btn btn-sm btn-ghost" type="button" data-note-delete={note.id}>
                    删除
                  </button>
                </div>
              </li>
            ))}
          </ul>
        )}
      </details>
    )
  }

  <article class="reader" id="reader">
    {
      page.units.map((unit) => {
        const zh = cachedMap.get(unit.index) || '';
        const zhClass = `zh-block${zh ? '' : ' is-empty'}${unit.type === 'heading' ? ' zh-heading' : ''}`;
        // 笔记：每段一个锚点按钮，记过的段落左侧有竖线（中文纯阅读同样适用）
        const noteCount = notesByBlock.get(unit.index) ?? 0;
        const blockClass =
          'reader-block' +
          (chapterStarts.has(unit.index) ? ' chapter-block' : '') +
          (noteCount ? ' has-note' : '');
        const noteButton = notesEnabled ? (
          <button
            class="note-add"
            type="button"
            data-note-add={unit.index}
            title={noteCount ? `这一段有 ${noteCount} 条笔记` : '为这一段记笔记'}
            aria-label={noteCount ? `这一段有 ${noteCount} 条笔记` : '为这一段记笔记'}
          >
            ✎
          </button>
        ) : null;
        // 中文纯阅读：直接输出纯文本（不包 .word，点了也不会查词）
        if (isZh) {
          return (
            <div class={blockClass} id={`block-${unit.index}`} data-block={unit.index} data-type={unit.type}>
              {noteButton}
              {unit.type === 'heading' ? <h2>{unit.text}</h2> : <p>{unit.text}</p>}
            </div>
          );
        }
        return (
          <div class={blockClass} id={`block-${unit.index}`} data-block={unit.index} data-type={unit.type}>
            {noteButton}
            {unit.type === 'heading' ? <h2>{unit.text}</h2> : <p set:html={tokenizeParagraph(unit.text)} />}
            <div class={zhClass} data-has-cache={zh ? '1' : '0'}>
              {zh || ''}
            </div>
          </div>
        );
      })
    }
  </article>

  {
    totalPages > 1 && (
      <nav class="pager pager-bottom" aria-label="分页">
        {currentPage > 1 ? (
          <a class="btn" href={pageHref(currentPage - 1)} rel="prev">‹ 上一页</a>
        ) : (
          <button class="btn" type="button" disabled>‹ 上一页</button>
        )}
        <span class="muted small">第 {currentPage} / {totalPages} 页</span>
        {currentPage < totalPages ? (
          <a class="btn btn-primary" href={pageHref(currentPage + 1)} rel="next">下一页 ›</a>
        ) : (
          <a class="btn btn-primary" href={isZh ? '/zh' : '/'}>全书完 · 返回列表</a>
        )}
      </nav>
    )
  }

  <div class="row" style="margin-top:16px; justify-content:center">
    <a class="btn" href={isZh ? '/zh' : '/'}>← 返回列表</a>
  </div>

  <div class="popover" id="word-popover" role="dialog" aria-label="单词释义" hidden></div>

  <script id="reader-meta" type="application/json" set:html={JSON.stringify(readerMeta)} />
  <script>
    import { initTranslate } from '../../scripts/client/translate';
    import { askText, confirmDelete, notify } from '../../scripts/client/dialog';
    import { initKeyboardPaging } from '../../scripts/client/reader/pager';
    import { initNotes } from '../../scripts/client/reader/notes';

    initTranslate();

    // 中文文章只加载翻页 / 改标题 / 删除，不加载点词与生词模块
    const readerLang = (
      JSON.parse(document.getElementById('reader-meta')?.textContent || '{}') as { lang?: string }
    ).lang;
    if (readerLang !== 'zh') void import('../../scripts/client/reader');

    const title = document.getElementById('article-title');

    // 改标题 / 删除文章
    const articleId = document.querySelector<HTMLScriptElement>('#reader-meta')?.textContent
      ? (JSON.parse(document.querySelector<HTMLScriptElement>('#reader-meta')!.textContent || '{}') as { articleId: string }).articleId
      : '';

    document.getElementById('rename-btn')?.addEventListener('click', async () => {
      const current = title?.textContent || '';
      const next = await askText('修改文章标题', current, '', '输入新的标题', {
        requiredMessage: '标题不能为空',
      });
      if (!next || next === current) return;
      const res = await fetch(`/api/articles?id=${encodeURIComponent(articleId)}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ title: next }),
      });
      if (res.ok && title) {
        title.textContent = next;
        document.title = `${next} · ${document.title.split(' · ').pop()}`;
      } else {
        await notify('修改失败', '请稍后再试。');
      }
    });

    document.getElementById('delete-btn')?.addEventListener('click', async () => {
      const ok = await confirmDelete(
        '删除这篇文章？',
        '文章正文会从服务器删除，生词本里的单词不会被删除。此操作不可恢复。',
        '删除文章'
      );
      if (!ok) return;
      const res = await fetch(`/api/articles?id=${encodeURIComponent(articleId)}`, { method: 'DELETE' });
      if (res.ok) location.href = '/';
      else await notify('删除失败', '请稍后再试。');
    });

    // 键盘翻页：← / →（输入框、弹窗内不触发）
    const meta = JSON.parse(document.getElementById('reader-meta')?.textContent || '{}') as {
      articleId: string;
      currentPage: number;
      totalPages: number;
      notes?: { enabled?: boolean; maxNoteChars?: number };
    };
    initKeyboardPaging(meta);

    // 笔记：段落锚点按钮 + 面板编辑 / 删除（中英文阅读都启用）
    initNotes({
      articleId: meta.articleId,
      enabled: meta.notes?.enabled === true,
      maxNoteChars: meta.notes?.maxNoteChars || 2000,
    });
  </script>
</BaseLayout>
